<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmf_simulation_lift_controller</name>
  <version>2.8.0</version>
  <description>
    Simulated lift controller that allocates simulated lifts for
    LiftSelectRequest messages and forwards them as LiftRequest messages to
    the Gazebo lift plugin.
  </description>
  <maintainer email="brandonk10.10@gmail.com">Brandon</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rmf_lift_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
